{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EffectData",
  "type": "object",
  "required": [
    "category",
    "css_properties"
  ],
  "properties": {
    "category": {
      "type": "string"
    },
    "css_properties": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "elements_count": {
      "default": 0,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "recipe": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}