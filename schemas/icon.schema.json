{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IconData",
  "type": "object",
  "required": [
    "geometry_hash",
    "height",
    "is_current_color",
    "svg",
    "view_box",
    "width"
  ],
  "properties": {
    "geometry_hash": {
      "type": "string"
    },
    "height": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "is_current_color": {
      "type": "boolean"
    },
    "set": {
      "anyOf": [
        {
          "$ref": "#/definitions/IconSetInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "svg": {
      "type": "string"
    },
    "view_box": {
      "type": "string"
    },
    "width": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    }
  },
  "additionalProperties": false,
  "definitions": {
    "IconSetInfo": {
      "type": "object",
      "required": [
        "license",
        "name"
      ],
      "properties": {
        "license": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}