{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaletteData",
  "type": "object",
  "required": [
    "colors",
    "scheme"
  ],
  "properties": {
    "colors": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/PaletteColor"
      }
    },
    "pairs": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/ContrastPair"
      }
    },
    "scheme": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "definitions": {
    "ColorUsage": {
      "type": "object",
      "required": [
        "area_pct",
        "elements"
      ],
      "properties": {
        "area_pct": {
          "type": "number",
          "format": "double"
        },
        "elements": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      },
      "additionalProperties": false
    },
    "ContrastPair": {
      "type": "object",
      "required": [
        "aa",
        "aaa",
        "bg",
        "fg",
        "wcag_ratio"
      ],
      "properties": {
        "aa": {
          "type": "boolean"
        },
        "aaa": {
          "type": "boolean"
        },
        "bg": {
          "type": "string"
        },
        "fg": {
          "type": "string"
        },
        "wcag_ratio": {
          "type": "number",
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "PaletteColor": {
      "type": "object",
      "required": [
        "alpha",
        "hex",
        "oklch",
        "role",
        "usage"
      ],
      "properties": {
        "alpha": {
          "type": "number",
          "format": "double"
        },
        "css_variables": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hex": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "oklch": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 3,
          "minItems": 3
        },
        "role": {
          "type": "string"
        },
        "usage": {
          "$ref": "#/definitions/ColorUsage"
        }
      },
      "additionalProperties": false
    }
  }
}